    "test": "./scripts/with-java21.sh firebase emulators:exec --only auth,storage --project demo-cs8803 'node --test \"tests/*.test.js\"'",
    "deploy": "npm run build && firebase deploy --only hosting,storage"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.29.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
