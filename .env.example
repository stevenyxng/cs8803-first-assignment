# Copy to .env.local and fill in from:
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup
#
# These are compiled into the client bundle and are PUBLIC by design.
# The Firebase web config is an identifier, not a secret — access control
# lives in storage.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
